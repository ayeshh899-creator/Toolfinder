rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document/path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document and subcollections
    // users/{userId}
    // users/{userId}/favorites/{docId}
    // users/{userId}/recentlyViewed/{docId}
    // users/{userId}/roadmapProgress/{docId}
    // users/{userId}/chatHistory/{docId}
    // users/{userId}/preferences/{docId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
